<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <system.webServer>
        <security>
            <requestFiltering>
                <!-- Allow 20GB uploads -->
                <requestLimits maxAllowedContentLength="4294967295" />
            </requestFiltering>
        </security>

        <!-- Enable compression for better transfer speeds -->
        <urlCompression doStaticCompression="true" doDynamicCompression="true" />
        <httpCompression>
            <dynamicTypes>
                <add mimeType="application/octet-stream" enabled="true" />
                <add mimeType="application/zip" enabled="false" />
                <add mimeType="application/x-zip-compressed" enabled="false" />
            </dynamicTypes>
        </httpCompression>

        <!-- Increase timeout for large file uploads -->
        <aspNetCore processPath="dotnet"
                    arguments=".\Collectibles.Web.dll"
                    stdoutLogEnabled="true"
                    stdoutLogFile=".\logs\stdout"
                    requestTimeout="00:20:00"
                    hostingModel="InProcess">
            <environmentVariables>
                <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
            </environmentVariables>
        </aspNetCore>
    </system.webServer>

    <!-- Disable all caching for theme-config so runtime theme changes take effect immediately -->
    <location path="theme-config">
        <system.webServer>
            <caching enabled="false" enableKernelCache="false" />
            <staticContent>
                <clientCache cacheControlMode="DisableCache" />
            </staticContent>
            <httpProtocol>
                <customHeaders>
                    <add name="Cache-Control" value="no-cache, no-store, must-revalidate" />
                </customHeaders>
            </httpProtocol>
        </system.webServer>
    </location>

    <system.web>
        <!-- Set maximum request length to 20GB (in KB) -->
        <httpRuntime maxRequestLength="20971520" executionTimeout="1200" />
    </system.web>
</configuration>
