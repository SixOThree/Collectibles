<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- Allow 20GB uploads -->
        <requestLimits maxAllowedContentLength="4294967295" xdt:Transform="Replace" />
      </requestFiltering>
    </security>
    
    <!-- Enable compression for better transfer speeds -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" xdt:Transform="Replace" />
    <httpCompression>
      <dynamicTypes xdt:Transform="Replace">
        <add mimeType="application/octet-stream" enabled="true" />
        <add mimeType="application/zip" enabled="false" />
        <add mimeType="application/x-zip-compressed" enabled="false" />
      </dynamicTypes>
    </httpCompression>
    
    <!-- Configure ASP.NET Core module for production with startup delay -->
    <aspNetCore processPath="dotnet" 
                arguments=".\Collectibles.Web.dll" 
                stdoutLogEnabled="true" 
                stdoutLogFile=".\logs\stdout"
                requestTimeout="00:20:00"
                hostingModel="InProcess"
                startupTimeLimit="300"
                shutdownTimeLimit="60"
                xdt:Transform="Replace">
      <environmentVariables>
        <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" xdt:Transform="Replace" xdt:Locator="Match(name)" />
      </environmentVariables>
    </aspNetCore>
    
    <!-- Configure application initialization module for preload and warm-up -->
    <applicationInitialization doAppInitAfterRestart="true" skipManagedModules="false" xdt:Transform="Insert">
      <add initializationPage="/health" />
    </applicationInitialization>
    
    <!-- Configure IIS application pool recycling and startup behavior -->
    <applicationPool xdt:Transform="Insert">
      <processModel idleTimeout="00:00:00" />
      <recycling>
        <periodicRestart time="03:00:00" />
      </recycling>
      <failure>
        <rapidFailProtection enabled="true" interval="00:05:00" maxCrashes="5" />
      </failure>
      <autoStart>true</autoStart>
      <startMode>AlwaysRunning</startMode>
    </applicationPool>
  </system.webServer>
  
  <system.web>
    <!-- Set maximum request length to 20GB (in KB) -->
    <httpRuntime maxRequestLength="20971520" executionTimeout="1200" xdt:Transform="Replace" />
  </system.web>
</configuration>