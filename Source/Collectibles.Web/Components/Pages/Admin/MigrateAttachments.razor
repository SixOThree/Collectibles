@page "/admin/migrate-attachments"
@rendermode InteractiveServerWithoutPrerender
@attribute [Authorize(Roles = "Administrator")]
@inherits LoggablePageBase
@using Collectibles.Application.Interfaces
@using Collectibles.Domain.Entities
@using MediatR
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Timers
@using System.Globalization
@using Collectibles.Application.Features.Attachments.Commands
@using Collectibles.Application.Features.Attachments.Dtos
@implements IDisposable
@inject IMediator Mediator
@inject IApplicationDbContext DbContext
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject IJSRuntime JSRuntime

<PageTitle>Migrate Attachments - Admin</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>
        <i class="bi bi-cloud-arrow-up"></i> Migrate Attachments to Azure Blob Storage
    </h1>
    <div class="d-flex gap-2 align-items-center">
        <span class="badge bg-info">
            <i class="bi bi-database"></i> Current Provider: @_currentStorageProvider
        </span>
        @if (_currentStorageProvider == "AzureBlobStorage")
        {
            <span class="badge @(_azureConnectionStatus ? "bg-success" : "bg-danger")">
                <i class="bi @(_azureConnectionStatus ? "bi-check-circle" : "bi-x-circle")"></i>
                Azure: @(_azureConnectionStatus ? "Connected" : "Disconnected")
            </span>
        }
        <span class="text-muted small">
            <i class="bi bi-clock"></i> Last refresh: @_lastRefreshTime.ToString("HH:mm:ss")
        </span>
    </div>
</div>

<div class="row">
    <div class="col-12">
        @if (!string.IsNullOrEmpty(_alertMessage))
        {
            <div class="alert @_alertCssClass alert-dismissible fade show" role="alert">
                @_alertMessage
                <button type="button" class="btn-close" @onclick="() => _alertMessage = string.Empty"></button>
            </div>
        }
    </div>
</div>

<!-- Dashboard Section -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">
                    <i class="bi bi-file-earmark-fill text-primary"></i> Total Attachments
                    <i class="bi bi-info-circle text-muted small" title="Total number of attachments in the system"></i>
                </h5>
                <p class="card-text display-6">@_totalAttachments</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">
                    <i class="bi bi-exclamation-triangle-fill text-warning"></i> Unmigrated
                    <i class="bi bi-info-circle text-muted small"  title="Attachments stored in database waiting for migration"></i>
                </h5>
                <p class="card-text display-6 text-warning">@_unmigratedCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">
                    <i class="bi bi-check-circle-fill text-success"></i> Migrated
                    <i class="bi bi-info-circle text-muted small"  title="Attachments successfully migrated to Azure Blob Storage"></i>
                </h5>
                <p class="card-text display-6 text-success">@_migratedCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">
                    <i class="bi bi-graph-up text-info"></i> Success Rate
                    <i class="bi bi-info-circle text-muted small"  title="Percentage of successfully migrated attachments"></i>
                </h5>
                <p class="card-text display-6">@(_totalAttachments > 0 ? $"{(_migratedCount * 100.0 / _totalAttachments):F1}%" : "N/A")</p>
            </div>
        </div>
    </div>
</div>

<!-- Charts Section -->
<div class="row mb-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-pie-chart"></i> Migration Status Distribution</h5>
            </div>
            <div class="card-body">
                <canvas id="statusChart" width="400" height="200"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-graph-up-arrow"></i> Migration Speed Over Time</h5>
            </div>
            <div class="card-body">
                <canvas id="speedChart" width="400" height="200"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Migration Controls -->
<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0">Migration Controls</h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-4">
                <div class="mb-3">
                    <label for="batchSize" class="form-label">Batch Size</label>
                    <input type="number" class="form-control" id="batchSize" @bind="_batchSize" 
                           min="1" max="1000" disabled="@_isMigrating">
                    <div class="form-text">Number of attachments to process at once (1-1000)</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="skipVerification" 
                               @bind="_skipVerification" disabled="@_isMigrating">
                        <label class="form-check-label" for="skipVerification">
                            Skip verification after migration
                        </label>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3">
                    @if (_isMigrating)
                    {
                        <button class="btn btn-danger" @onclick="CancelMigration">
                            <i class="bi bi-stop-circle"></i> Cancel Migration
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-primary" @onclick="StartMigration" disabled="@(_unmigratedCount == 0)">
                            <i class="bi bi-cloud-upload"></i> Start Migration
                        </button>
                    }
                </div>
            </div>
        </div>

        @if (_isMigrating)
        {
            <div class="mt-3">
                <div class="mb-2 d-flex justify-content-between align-items-center">
                    <div>
                        <strong>Overall Progress:</strong> @_processedCount / @_totalToProcess
                        @if (!string.IsNullOrEmpty(_estimatedTimeRemaining))
                        {
                            <span class="ms-3">ETA: @_estimatedTimeRemaining</span>
                        }
                    </div>
                    <div class="text-end">
                        <span class="badge bg-info">
                            <i class="bi bi-speedometer2"></i> @_attachmentsPerSecond.ToString("F1") items/sec
                        </span>
                        <span class="badge bg-secondary ms-2">
                            <i class="bi bi-arrow-down-up"></i> @_dataTransferRate MB/s
                        </span>
                    </div>
                </div>
                
                <!-- Overall Progress Bar -->
                <div class="progress mb-3" style="height: 30px;">
                    <div class="progress-bar @GetProgressBarClass() progress-bar-striped progress-bar-animated" 
                         role="progressbar" 
                         style="width: @(_progressPercentage)%"
                         aria-valuenow="@_progressPercentage" 
                         aria-valuemin="0" 
                         aria-valuemax="100">
                        <strong>@_progressPercentage%</strong>
                    </div>
                </div>

                <!-- Stage Progress -->
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="small text-muted">Processing</label>
                        <div class="progress" style="height: 15px;">
                            <div class="progress-bar bg-info" role="progressbar" style="width: @_processingProgress%"></div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="small text-muted">Uploading</label>
                        <div class="progress" style="height: 15px;">
                            <div class="progress-bar bg-warning" role="progressbar" style="width: @_uploadingProgress%"></div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="small text-muted">Verifying</label>
                        <div class="progress" style="height: 15px;">
                            <div class="progress-bar bg-success" role="progressbar" style="width: @_verifyingProgress%"></div>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_currentAttachment))
                {
                    <div class="alert alert-info py-2">
                        <div class="d-flex align-items-center">
                            <Spinner Type="SpinnerType.Dots" Size="SpinnerSize.Small" Color="SpinnerColor.Info" Class="me-2" />
                            <small>
                                <strong>Current File:</strong> @_currentAttachment
                                <span class="ms-3">Size: @_currentFileSize</span>
                                <span class="ms-3">Progress: @_currentFileProgress%</span>
                            </small>
                        </div>
                        <div class="progress mt-2" style="height: 10px;">
                            <div class="progress-bar" role="progressbar" style="width: @_currentFileProgress%"></div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- Migration History -->
<div class="card mb-4">
    <div class="card-header">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-clock-history"></i> Migration History</h5>
            <div class="d-flex gap-2">
                <button class="btn btn-sm btn-outline-primary" @onclick="ExportMigrationHistory">
                    <i class="bi bi-download"></i> Export to CSV
                </button>
            </div>
        </div>
    </div>
    <div class="card-body">
        <!-- Date Range Filter -->
        <div class="row mb-3">
            <div class="col-md-4">
                <label class="form-label small">From Date</label>
                <input type="date" class="form-control form-control-sm" @bind="_historyFromDate" />
            </div>
            <div class="col-md-4">
                <label class="form-label small">To Date</label>
                <input type="date" class="form-control form-control-sm" @bind="_historyToDate" />
            </div>
            <div class="col-md-4">
                <label class="form-label small">&nbsp;</label>
                <button class="btn btn-sm btn-secondary d-block" @onclick="FilterMigrationHistory">
                    <i class="bi bi-funnel"></i> Apply Filter
                </button>
            </div>
        </div>

        @if (GetFilteredMigrationHistory().Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Start Time</th>
                            <th>Duration</th>
                            <th>Total Processed</th>
                            <th>Success Count</th>
                            <th>Failed Count</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var history in GetFilteredMigrationHistory())
                        {
                            <tr>
                                <td>@history.StartTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>@history.Duration</td>
                                <td>@history.TotalProcessed</td>
                                <td class="text-success">
                                    <i class="bi bi-check-circle"></i> @history.SuccessCount
                                </td>
                                <td class="text-danger">
                                    <i class="bi bi-x-circle"></i> @history.FailedCount
                                </td>
                                <td>
                                    <span class="badge @(history.Status == "Completed" ? "bg-success" : history.Status == "Cancelled" ? "bg-warning" : "bg-danger")">
                                        @history.Status
                                    </span>
                                </td>
                                <td>
                                    @if (history.FailedCount > 0)
                                    {
                                        <button class="btn btn-sm btn-outline-warning" @onclick="() => RetryFailedMigrations(history)" 
                                                 title="Retry failed migrations from this batch">
                                            <i class="bi bi-arrow-clockwise"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted">No migration history available for the selected date range.</p>
        }
    </div>
</div>

<!-- Error Log Section -->
<div class="card mb-4">
    <div class="card-header">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <button class="btn btn-link text-decoration-none p-0" type="button" 
                        data-bs-toggle="collapse" data-bs-target="#errorLogCollapse" 
                        aria-expanded="@(_migrationErrors.Any() ? "true" : "false")" 
                        aria-controls="errorLogCollapse">
                    <i class="bi bi-chevron-down"></i> Error Log 
                    @if (_migrationErrors.Any())
                    {
                        <span class="badge bg-danger ms-2">@_migrationErrors.Count</span>
                    }
                </button>
            </h5>
            <div class="d-flex gap-2">
                <button class="btn btn-sm btn-outline-danger" @onclick="ExportErrorLog" disabled="@(!_migrationErrors.Any())">
                    <i class="bi bi-download"></i> Export Errors
                </button>
            </div>
        </div>
    </div>
    <div class="collapse @(_migrationErrors.Any() ? "show" : "")" id="errorLogCollapse">
        <div class="card-body">
            @if (_migrationErrors.Any())
            {
                <!-- Search Box -->
                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                            <input type="text" class="form-control" placeholder="Search by attachment name..." 
                                   @bind="_errorSearchTerm" @bind:event="oninput" />
                        </div>
                    </div>
                    <div class="col-md-6 text-end">
                        <span class="text-muted small">
                            Showing @GetPagedErrors().Count() of @GetFilteredErrors().Count() errors
                        </span>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-sm table-hover">
                        <thead>
                            <tr>
                                <th>Attachment Name</th>
                                <th>Error Type</th>
                                <th>Details</th>
                                <th>Time</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var error in GetPagedErrors())
                            {
                                <tr>
                                    <td>
                                        <i class="bi bi-file-earmark-x text-danger"></i> @error.AttachmentName
                                    </td>
                                    <td><span class="badge bg-danger">@error.ErrorType</span></td>
                                    <td>
                                        <small class="text-break">@error.Details</small>
                                    </td>
                                    <td><small>@error.Timestamp.ToString("HH:mm:ss")</small></td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-warning" 
                                                @onclick="() => RetryFailedAttachment(error.AttachmentName)"
                                                 title="Retry this attachment">
                                            <i class="bi bi-arrow-clockwise"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (GetFilteredErrors().Count() > _errorPageSize)
                {
                    <nav aria-label="Error log pagination">
                        <ul class="pagination pagination-sm justify-content-center">
                            <li class="page-item @(_errorCurrentPage == 1 ? "disabled" : "")">
                                <button class="page-link" @onclick="() => ChangeErrorPage(_errorCurrentPage - 1)">
                                    Previous
                                </button>
                            </li>
                            @for (int i = 1; i <= ErrorTotalPages; i++)
                            {
                                var pageNumber = i;
                                <li class="page-item @(_errorCurrentPage == pageNumber ? "active" : "")">
                                    <button class="page-link" @onclick="() => ChangeErrorPage(pageNumber)">
                                        @pageNumber
                                    </button>
                                </li>
                            }
                            <li class="page-item @(_errorCurrentPage == ErrorTotalPages ? "disabled" : "")">
                                <button class="page-link" @onclick="() => ChangeErrorPage(_errorCurrentPage + 1)">
                                    Next
                                </button>
                            </li>
                        </ul>
                    </nav>
                }

                <div class="d-flex justify-content-between mt-3">
                    <button class="btn btn-sm btn-outline-danger" @onclick="ClearErrors">
                        <i class="bi bi-trash"></i> Clear Error Log
                    </button>
                    <button class="btn btn-sm btn-outline-warning" @onclick="RetryAllFailed">
                        <i class="bi bi-arrow-clockwise"></i> Retry All Failed
                    </button>
                </div>
            }
            else
            {
                <div class="text-center text-muted py-4">
                    <i class="bi bi-check-circle display-4"></i>
                    <p class="mt-2">No errors recorded.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Rollback Section -->
<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0"><i class="bi bi-arrow-counterclockwise"></i> Rollback Migration</h5>
    </div>
    <div class="card-body">
        @if (_isRollingBack)
        {
            <div class="alert alert-warning">
                <div class="d-flex align-items-center">
                    <Spinner Type="SpinnerType.Dots" Size="SpinnerSize.Small" Color="SpinnerColor.Warning" Class="me-2" />
                    <strong>Rollback in progress...</strong>
                </div>
                <div class="mt-2">
                    <small>Processed: @_rollbackResult?.TotalProcessed | Success: @_rollbackResult?.SuccessCount | Failed: @_rollbackResult?.FailureCount</small>
                </div>
            </div>
        }
        else if (_rollbackResult != null)
        {
            <div class="alert @(_rollbackResult.FailureCount > 0 ? "alert-warning" : "alert-success")">
                <h6>Rollback Completed</h6>
                <div>
                    <strong>Total Processed:</strong> @_rollbackResult.TotalProcessed<br>
                    <strong>Success:</strong> @_rollbackResult.SuccessCount<br>
                    <strong>Failed:</strong> @_rollbackResult.FailureCount<br>
                    <strong>Duration:</strong> @_rollbackResult.Duration.ToString(@"mm\:ss")
                </div>
                @if (_rollbackResult.Errors.Any())
                {
                    <div class="mt-3">
                        <h6>Errors:</h6>
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Attachment</th>
                                        <th>Error Type</th>
                                        <th>Message</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var error in _rollbackResult.Errors.Take(10))
                                    {
                                        <tr>
                                            <td>@error.AttachmentName</td>
                                            <td>@error.ErrorType</td>
                                            <td>@error.ErrorMessage</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            @if (_rollbackResult.Errors.Count > 10)
                            {
                                <small class="text-muted">Showing first 10 of @_rollbackResult.Errors.Count errors</small>
                            }
                        </div>
                    </div>
                }
            </div>
        }

        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label class="form-label">Rollback Options</label>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="deleteFromStorage" 
                               @bind="_rollbackDeleteFromStorage" disabled="@_isRollingBack">
                        <label class="form-check-label" for="deleteFromStorage">
                            Delete files from Azure Blob Storage
                        </label>
                    </div>
                    <div class="form-text">If unchecked, files will remain in storage but database references will be cleared</div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label for="rollbackBatchSize" class="form-label">Batch Size</label>
                    <input type="number" class="form-control" id="rollbackBatchSize" @bind="_rollbackBatchSize" 
                           min="1" max="1000" disabled="@_isRollingBack">
                    <div class="form-text">Number of attachments to process at once (1-1000)</div>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-danger" @onclick="RollbackAll" disabled="@(_isRollingBack || _migratedCount == 0)">
                <i class="bi bi-arrow-counterclockwise"></i> Rollback All Migrated
            </button>
            <button class="btn btn-warning" @onclick="ShowRollbackSelectedDialog" disabled="@(_isRollingBack || _migratedCount == 0)">
                <i class="bi bi-arrow-counterclockwise"></i> Rollback Selected
            </button>
        </div>
    </div>
</div>

<!-- Cleanup Section -->
<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0"><i class="bi bi-trash3"></i> Cleanup Database Content</h5>
    </div>
    <div class="card-body">
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle"></i> <strong>Warning:</strong> This will permanently remove database content for migrated attachments. Ensure files are successfully stored in Azure Blob Storage before cleanup.
        </div>
        
        <div class="row mb-3">
            <div class="col-md-4">
                <label for="retentionDays" class="form-label">Retention Days</label>
                <input type="number" class="form-control" id="retentionDays" @bind="_cleanupRetentionDays" 
                       min="1" max="365" disabled="@_isCleaningUp">
                <div class="form-text">Keep database content for this many days after migration</div>
            </div>
            <div class="col-md-4">
                <label for="cleanupBatchSize" class="form-label">Batch Size</label>
                <input type="number" class="form-control" id="cleanupBatchSize" @bind="_cleanupBatchSize" 
                       min="1" max="1000" disabled="@_isCleaningUp">
                <div class="form-text">Number of attachments to process at once</div>
            </div>
            <div class="col-md-4">
                <div class="form-check mt-4">
                    <input class="form-check-input" type="checkbox" id="onlyVerified" 
                           @bind="_cleanupOnlyVerified" disabled="@_isCleaningUp">
                    <label class="form-check-label" for="onlyVerified">
                        Only Verified Attachments
                    </label>
                    <div class="form-text">Clean up only attachments that passed verification</div>
                </div>
            </div>
        </div>

        @if (_cleanupPreviewResult != null)
        {
            <div class="alert alert-info mb-3">
                <h6><i class="bi bi-info-circle"></i> Cleanup Preview</h6>
                <div class="row">
                    <div class="col-md-6">
                        <strong>Eligible Attachments:</strong> @_cleanupPreviewResult.TotalEligible<br>
                        <strong>Space to Reclaim:</strong> @FormatBytes(_cleanupPreviewResult.SpaceReclaimed)
                    </div>
                    <div class="col-md-6">
                        <strong>Retention Date:</strong> @DateTime.UtcNow.AddDays(-_cleanupRetentionDays).ToString("yyyy-MM-dd")<br>
                        <strong>Status:</strong> Ready to clean
                    </div>
                </div>
            </div>
        }

        @if (_cleanupResult != null && !_isCleaningUp)
        {
            <div class="alert @(_cleanupResult.Errors.Any() ? "alert-warning" : "alert-success") mb-3">
                <h6><i class="bi bi-check-circle"></i> Cleanup Completed</h6>
                <div class="row">
                    <div class="col-md-6">
                        <strong>Total Processed:</strong> @_cleanupResult.TotalEligible<br>
                        <strong>Cleaned:</strong> @_cleanupResult.CleanedCount<br>
                        <strong>Skipped:</strong> @_cleanupResult.SkippedCount
                    </div>
                    <div class="col-md-6">
                        <strong>Space Reclaimed:</strong> @FormatBytes(_cleanupResult.SpaceReclaimed)<br>
                        <strong>Duration:</strong> @((_cleanupResult.EndTime - _cleanupResult.StartTime).ToString(@"mm\:ss"))
                    </div>
                </div>
                @if (_cleanupResult.Errors.Any())
                {
                    <div class="mt-3">
                        <h6>Errors:</h6>
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Attachment</th>
                                        <th>Error Type</th>
                                        <th>Reason</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var error in _cleanupResult.Errors.Take(5))
                                    {
                                        <tr>
                                            <td>@error.AttachmentName</td>
                                            <td>@error.ErrorType</td>
                                            <td>@error.Reason</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            @if (_cleanupResult.Errors.Count > 5)
                            {
                                <small class="text-muted">Showing first 5 of @_cleanupResult.Errors.Count errors</small>
                            }
                        </div>
                    </div>
                }
            </div>
        }

        <div class="d-flex gap-2">
            @if (_isCleaningUp)
            {
                <button class="btn btn-secondary" disabled>
                    <Spinner Type="SpinnerType.Dots" Size="SpinnerSize.Small" Color="SpinnerColor.Light" Class="me-2" />
                    Cleaning Up...
                </button>
            }
            else
            {
                <button class="btn btn-info" @onclick="PreviewCleanup" disabled="@(_migratedCount == 0)">
                    <i class="bi bi-eye"></i> Preview Cleanup
                </button>
                <button class="btn btn-danger" @onclick="ExecuteCleanup" 
                        disabled="@(_migratedCount == 0 || _cleanupPreviewResult == null || _cleanupPreviewResult.TotalEligible == 0)">
                    <i class="bi bi-trash3-fill"></i> Execute Cleanup
                </button>
            }
        </div>
    </div>
</div>

<!-- Quick Actions Section -->
<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0"><i class="bi bi-lightning-charge"></i> Quick Actions</h5>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <button class="btn btn-outline-primary w-100" @onclick="MarkSelectedAsMigrated" 
                         title="Manually mark selected attachments as migrated">
                    <i class="bi bi-check-all"></i> Mark as Migrated
                </button>
            </div>
            <div class="col-md-4">
                <button class="btn btn-outline-danger w-100" @onclick="ResetMigrationStatus"
                         title="Reset migration status for all attachments">
                    <i class="bi bi-arrow-counterclockwise"></i> Reset Status
                </button>
            </div>
            <div class="col-md-4">
                <button class="btn btn-outline-info w-100" @onclick="RefreshDashboard">
                    <i class="bi bi-arrow-repeat"></i> Refresh Dashboard
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Verification Section -->
<div class="card">
    <div class="card-header">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-shield-check"></i> Verification</h5>
            <div class="d-flex gap-2">
                <button class="btn btn-sm btn-outline-success" @onclick="ExportVerificationResults" 
                        disabled="@(!_verificationResults.Any())">
                    <i class="bi bi-download"></i> Export Results
                </button>
            </div>
        </div>
    </div>
    <div class="card-body">
        <div class="d-flex gap-2 mb-3">
            <button class="btn btn-info" @onclick="RunVerification" disabled="@(_isVerifying || _isMigrating)">
                @if (_isVerifying)
                {
                    <Spinner Type="SpinnerType.Dots" Size="SpinnerSize.Small" Color="SpinnerColor.Light" Class="me-2" />
                }
                <i class="bi bi-check-circle"></i> Run Full Verification
            </button>
            <button class="btn btn-outline-info" @onclick="RunQuickVerification" disabled="@(_isVerifying || _isMigrating)">
                <i class="bi bi-lightning"></i> Quick Verify (Last 100)
            </button>
        </div>

        @if (_verificationResults.Any())
        {
            <div class="mt-3">
                <h6><i class="bi bi-clipboard-check"></i> Verification Results:</h6>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="alert @(_verificationErrors.Any() ? "alert-warning" : "alert-success")">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>Total Verified:</strong> @_verificationResults.Count<br>
                                    <strong>Errors Found:</strong> @_verificationErrors.Count
                                </div>
                                <div class="text-end">
                                    <span class="badge @(_verificationErrors.Any() ? "bg-warning" : "bg-success") fs-6">
                                        @((_verificationResults.Count - _verificationErrors.Count) * 100.0 / _verificationResults.Count):F1% Valid
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <canvas id="verificationChart" width="200" height="100"></canvas>
                    </div>
                </div>

                @if (_verificationErrors.Any())
                {
                    <h6><i class="bi bi-exclamation-triangle text-warning"></i> Verification Issues:</h6>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover">
                            <thead>
                                <tr>
                                    <th>Attachment</th>
                                    <th>Issue</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var error in _verificationErrors)
                                {
                                    <tr>
                                        <td>
                                            <i class="bi bi-file-earmark-medical text-warning"></i> @error.AttachmentName
                                        </td>
                                        <td class="text-danger">
                                            <small>@error.Issue</small>
                                        </td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-warning" 
                                                    @onclick="() => FixVerificationIssue(error)">
                                                <i class="bi bi-wrench"></i> Fix
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
        else if (_isVerifying)
        {
            <div class="text-center py-4">
                <Spinner Type="SpinnerType.Dots" Color="SpinnerColor.Info" />
                <p class="mt-2 text-muted">Running verification checks...</p>
            </div>
        }
    </div>
</div>

@code {
    private Timer? _progressTimer;
