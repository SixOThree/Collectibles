    // Rollback methods
    private async Task RollbackAll()
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", 
            "Are you sure you want to rollback ALL migrated attachments? This action cannot be undone.");
        
        if (!confirmed)
        {
            return;
        }

        _isRollingBack = true;
        _rollbackResult = null;
        StateHasChanged();

        try
        {
            // Log rollback start
            await LogAction(EventAction.Other, new
            {
                Action = "RollbackStarted",
                Type = "All",
                DeleteFromStorage = _rollbackDeleteFromStorage,
                BatchSize = _rollbackBatchSize,
                MigratedCount = _migratedCount
            });

            var command = new RollbackAttachmentMigrationCommand
            {
                AttachmentIds = new List<long>(), // Empty list means rollback all
                DeleteFromStorage = _rollbackDeleteFromStorage,
                BatchSize = _rollbackBatchSize
            };

            _rollbackResult = await Mediator.Send(command);

            // Log rollback completion
            await LogAction(EventAction.Other, new
            {
                Action = "RollbackCompleted",
                TotalProcessed = _rollbackResult.TotalProcessed,
                SuccessCount = _rollbackResult.SuccessCount,
                FailureCount = _rollbackResult.FailureCount,
                Duration = _rollbackResult.Duration.ToString(@"mm\:ss"),
                DeletedFromStorage = _rollbackDeleteFromStorage
            });

            if (_rollbackResult.FailureCount == 0)
            {
                ShowAlert($"Rollback completed successfully. {_rollbackResult.SuccessCount} attachments rolled back.", "alert-success");
            }
            else
            {
                ShowAlert($"Rollback completed with errors. Success: {_rollbackResult.SuccessCount}, Failed: {_rollbackResult.FailureCount}", "alert-warning");
            }

            await LoadDashboardStats();
        }
        catch (Exception ex)
        {
            ShowAlert($"Rollback failed: {ex.Message}", "alert-danger");
        }
        finally
        {
            _isRollingBack = false;
            StateHasChanged();
        }
    }

