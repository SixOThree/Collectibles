        _verificationErrors.Clear();
        
        ShowAlert("Running quick verification on last 100 migrated attachments...", "alert-info");
        
        try
        {
            var attachmentsToVerify = await DbContext.Attachments
                .Where(a => a.IsMigrated)
                .OrderByDescending(a => a.MigrationDate)
                .Take(100)
                .ToListAsync();
            
            // Perform verification (simplified)
            foreach (var attachment in attachmentsToVerify)
            {
                _verificationResults.Add(new VerificationResult
                {
                    AttachmentId = attachment.Id,
                    AttachmentName = attachment.OriginalFilename ?? attachment.Name,
                    IsValid = !string.IsNullOrEmpty(attachment.FilePath)
                });
