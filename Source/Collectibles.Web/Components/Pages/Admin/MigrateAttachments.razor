    private IEnumerable<MigrationError> GetFilteredErrors()
    {
        if (string.IsNullOrWhiteSpace(_errorSearchTerm))
        {
            return _migrationErrors.OrderByDescending(e => e.Timestamp);
        }
        
        return _migrationErrors
            .Where(e => e.AttachmentName.Contains(_errorSearchTerm, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(e => e.Timestamp);
    }

    private IEnumerable<MigrationError> GetPagedErrors()
    {
        return GetFilteredErrors()
            .Skip((_errorCurrentPage - 1) * _errorPageSize)
            .Take(_errorPageSize);
    }

    private int ErrorTotalPages => (int)Math.Ceiling(GetFilteredErrors().Count() / (double)_errorPageSize);

    private void ChangeErrorPage(int page)
    {
        if (page >= 1 && page <= ErrorTotalPages)
        {
            _errorCurrentPage = page;
        }
    }

