    private async Task RefreshDashboard()
    {
        await LoadDashboardStats();
        _lastRefreshTime = DateTime.Now;
        await InvokeAsync(StateHasChanged);
    }

    private string GetProgressBarClass()
    {
        if (_progressPercentage < 33) return "bg-danger";
        if (_progressPercentage < 66) return "bg-warning";
        return "bg-success";
    }

    private void UpdateProgress()
    {
        if (_totalToProcess > 0)
        {
            _progressPercentage = (_processedCount * 100) / _totalToProcess;
            
            // Calculate estimated time remaining
            var elapsed = DateTime.Now - _migrationStartTime;
            if (_processedCount > 0)
            {
                var avgTimePerItem = elapsed.TotalSeconds / _processedCount;
                _attachmentsPerSecond = 1.0 / avgTimePerItem;
                
                var remainingItems = _totalToProcess - _processedCount;
                var estimatedSeconds = avgTimePerItem * remainingItems;
                _estimatedTimeRemaining = TimeSpan.FromSeconds(estimatedSeconds).ToString(@"mm\:ss");
                
                // Update stage progress (simulated)
                _processingProgress = Math.Min(100, (_processedCount * 100) / _totalToProcess + 10);
                _uploadingProgress = Math.Min(100, (_processedCount * 100) / _totalToProcess);
                _verifyingProgress = Math.Min(100, Math.Max(0, (_processedCount * 100) / _totalToProcess - 10));
                
                // Update file progress (simulated)
                _currentFileProgress = Random.Shared.Next(0, 101);
                _currentFileSize = $"{Random.Shared.Next(100, 5000)} KB";
                _dataTransferRate = $"{Random.Shared.Next(1, 10)}.{Random.Shared.Next(0, 10)}";
            }
        }
    }

