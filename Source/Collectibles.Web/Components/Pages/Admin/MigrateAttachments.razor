    // Filtering methods
    private IEnumerable<MigrationHistoryItem> GetFilteredMigrationHistory()
    {
        var query = _migrationHistory.AsEnumerable();
        
        if (_historyFromDate.HasValue)
        {
            query = query.Where(h => h.StartTime >= _historyFromDate.Value);
        }
        
        if (_historyToDate.HasValue)
        {
            query = query.Where(h => h.StartTime <= _historyToDate.Value.AddDays(1));
        }
        
        return query.OrderByDescending(h => h.StartTime).Take(10);
    }

    private void FilterMigrationHistory()
    {
        StateHasChanged();
