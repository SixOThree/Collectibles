    // Cleanup methods
    private async Task PreviewCleanup()
    {
        _isCleaningUp = true;
        _cleanupPreviewResult = null;
        StateHasChanged();

        try
        {
            var command = new CleanupMigratedAttachmentsCommand
            {
                OnlyVerified = _cleanupOnlyVerified,
                RetentionDays = _cleanupRetentionDays,
                BatchSize = _cleanupBatchSize,
                PreviewOnly = true
            };

            _cleanupPreviewResult = await Mediator.Send(command);

            if (_cleanupPreviewResult.TotalEligible == 0)
            {
                ShowAlert("No attachments are eligible for cleanup with the current settings.", "alert-info");
            }
            else
            {
                ShowAlert($"Preview complete. {_cleanupPreviewResult.TotalEligible} attachments eligible for cleanup.", "alert-info");
            }
        }
        catch (Exception ex)
        {
            ShowAlert($"Cleanup preview failed: {ex.Message}", "alert-danger");
        }
        finally
        {
            _isCleaningUp = false;
            StateHasChanged();
        }
    }

    private async Task ExecuteCleanup()
    {
        var spaceMB = _cleanupPreviewResult != null ? _cleanupPreviewResult.SpaceReclaimed / (1024.0 * 1024.0) : 0;
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", 
            $"Are you sure you want to permanently delete database content for {_cleanupPreviewResult?.TotalEligible} attachments? " +
            $"This will free up approximately {spaceMB:F2} MB of database space. This action cannot be undone.");
        
        if (!confirmed)
        {
            return;
        }

        _isCleaningUp = true;
        _cleanupResult = null;
        StateHasChanged();

        try
        {
            // Log cleanup start
            await LogAction(EventAction.Delete, new
            {
                Action = "CleanupStarted",
                EntityType = "AttachmentContent",
                TotalEligible = _cleanupPreviewResult?.TotalEligible,
                EstimatedSpaceReclaimMB = spaceMB,
                OnlyVerified = _cleanupOnlyVerified,
                RetentionDays = _cleanupRetentionDays
            });

            var command = new CleanupMigratedAttachmentsCommand
            {
                OnlyVerified = _cleanupOnlyVerified,
                RetentionDays = _cleanupRetentionDays,
                BatchSize = _cleanupBatchSize,
                PreviewOnly = false
            };

            _cleanupResult = await Mediator.Send(command);

            // Log cleanup completion
            var actualReclaimedMB = _cleanupResult.SpaceReclaimed / (1024.0 * 1024.0);
            await LogAction(EventAction.Delete, new
            {
                Action = "CleanupCompleted",
                EntityType = "AttachmentContent",
                CleanedCount = _cleanupResult.CleanedCount,
                SkippedCount = _cleanupResult.SkippedCount,
                SpaceReclaimedMB = actualReclaimedMB,
                Duration = (_cleanupResult.EndTime - _cleanupResult.StartTime).ToString(@"mm\:ss"),
                ErrorCount = _cleanupResult.Errors.Count
            });

            if (_cleanupResult.Errors.Any())
            {
                ShowAlert($"Cleanup completed with errors. Cleaned: {_cleanupResult.CleanedCount}, Failed: {_cleanupResult.SkippedCount}", "alert-warning");
            }
            else
            {
                ShowAlert($"Cleanup completed successfully. {_cleanupResult.CleanedCount} attachments cleaned, {actualReclaimedMB:F2} MB reclaimed.", "alert-success");
            }

            // Clear preview after execution
            _cleanupPreviewResult = null;
        }
        catch (Exception ex)
        {
            ShowAlert($"Cleanup failed: {ex.Message}", "alert-danger");
        }
        finally
        {
            _isCleaningUp = false;
            StateHasChanged();
        }
    }

    private string FormatBytes(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB", "TB" };
        int order = 0;
        double size = bytes;
        
        while (size >= 1024 && order < sizes.Length - 1)
        {
            order++;
            size = size / 1024;
        }

        return $"{size:F2} {sizes[order]}";
    }

