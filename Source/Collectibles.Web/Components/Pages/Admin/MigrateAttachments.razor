    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardStats();
        await LoadMigrationHistory();
        LoadStorageConfiguration();
        await InitializeCharts();
        
        // Set up refresh timer
        _refreshTimer = new Timer(30000); // Refresh every 30 seconds
        _refreshTimer.Elapsed += async (sender, e) => await RefreshDashboard();
        _refreshTimer.Start();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await DrawCharts();
        }
    }

    private async Task LoadDashboardStats()
    {
        try
        {
            _totalAttachments = await DbContext.Attachments.CountAsync();
            _unmigratedCount = await DbContext.Attachments
                .Where(a => !a.IsMigrated)
                .CountAsync();
            _migratedCount = _totalAttachments - _unmigratedCount;
        }
        catch (Exception ex)
        {
            ShowAlert($"Error loading dashboard stats: {ex.Message}", "alert-danger");
        }
    }

    private async Task LoadMigrationHistory()
    {
        // In a real implementation, this would load from a migration history table
        // For now, we'll just maintain it in memory during the session
        await Task.CompletedTask;
    }

    private async Task StartMigration()
    {
        var confirmed = await ConfirmAction("Are you sure you want to start the migration process?");
        if (!confirmed)
        {
            return;
        }

        _isMigrating = true;
        _cancellationTokenSource = new CancellationTokenSource();
        _migrationErrors.Clear();
        _processedCount = 0;
        _totalToProcess = _unmigratedCount;
        _migrationStartTime = DateTime.Now;

        // Start progress timer
        _progressTimer = new Timer(1000); // Update every second
        _progressTimer.Elapsed += async (sender, e) => await InvokeAsync(StateHasChanged);
        _progressTimer.Start();

        try
        {
            await PerformMigration(_cancellationTokenSource.Token);
            
            if (!_skipVerification && !_cancellationTokenSource.Token.IsCancellationRequested)
            {
                await RunVerification();
            }

            ShowAlert("Migration completed successfully!", "alert-success");
        }
        catch (OperationCanceledException)
        {
            ShowAlert("Migration was cancelled.", "alert-warning");
            RecordMigrationHistory("Cancelled");
        }
        catch (Exception ex)
        {
            ShowAlert($"Migration failed: {ex.Message}", "alert-danger");
            RecordMigrationHistory("Failed");
        }
        finally
        {
            _isMigrating = false;
            _progressTimer?.Stop();
            _progressTimer?.Dispose();
            _cancellationTokenSource?.Dispose();
            await LoadDashboardStats();
        }
    }

    private async Task PerformMigration(CancellationToken cancellationToken)
    {
        var successCount = 0;
        var failedCount = 0;

        // Log migration start
        await LogAction(EventAction.Other, new
        {
            Action = "MigrationStarted",
            TotalToProcess = _totalToProcess,
            BatchSize = _batchSize,
            SkipVerification = _skipVerification
        });

        while (_processedCount < _totalToProcess && !cancellationToken.IsCancellationRequested)
        {
            var batch = await DbContext.Attachments
                .Where(a => !a.IsMigrated)
                .Include(a => a.AttachmentContent)
                .Take(_batchSize)
                .ToListAsync(cancellationToken);

            if (!batch.Any())
            {
                break;
            }

            foreach (var attachment in batch)
            {
                if (cancellationToken.IsCancellationRequested)
                {
                    break;
                }

                _currentAttachment = attachment.OriginalFilename ?? attachment.Name;
                UpdateProgress();

                try
                {
                    // Simulate migration process
                    // In real implementation, this would call the actual migration command
                    await Task.Delay(100, cancellationToken); // Simulate work
                    
                    // For demo purposes, mark as migrated
                    attachment.FilePath = $"collectibles-attachments/attachments/{Guid.NewGuid()}/{attachment.OriginalFilename ?? attachment.Name}";
                    attachment.IsMigrated = true;
                    attachment.MigrationDate = DateTime.UtcNow;
                    
                    successCount++;
                }
                catch (Exception ex)
                {
                    failedCount++;
                    _migrationErrors.Add(new MigrationError
                    {
                        AttachmentName = attachment.OriginalFilename ?? attachment.Name,
                        ErrorType = ex.GetType().Name,
                        Details = ex.Message,
                        Timestamp = DateTime.Now
                    });
                }

                _processedCount++;
            }

            // Save batch changes
            await DbContext.SaveChangesAsync(cancellationToken);
        }

        RecordMigrationHistory("Completed", successCount, failedCount);

        // Log migration completion
        await LogAction(EventAction.Other, new
        {
            Action = "MigrationCompleted",
            Status = cancellationToken.IsCancellationRequested ? "Cancelled" : "Completed",
            TotalProcessed = _processedCount,
            SuccessCount = successCount,
            FailedCount = failedCount,
            Duration = (DateTime.Now - _migrationStartTime).ToString(@"mm\:ss")
        });
    }


    private void CancelMigration()
    {
        _cancellationTokenSource?.Cancel();
    }

    private async Task RunVerification()
    {
        _isVerifying = true;
        _verificationResults.Clear();
        _verificationErrors.Clear();

        try
        {
            var migratedAttachments = await DbContext.Attachments
                .Where(a => a.IsMigrated)
                .ToListAsync();

            foreach (var attachment in migratedAttachments)
            {
                var result = new VerificationResult
                {
                    AttachmentId = attachment.Id,
                    AttachmentName = attachment.OriginalFilename ?? attachment.Name,
                    IsValid = true
                };

                // Perform verification checks
                if (!attachment.IsMigrated)
                {
                    result.IsValid = false;
                    _verificationErrors.Add(new VerificationError
                    {
                        AttachmentName = attachment.OriginalFilename ?? attachment.Name,
                        Issue = "Attachment not marked as migrated"
                    });
                }

                if (string.IsNullOrEmpty(attachment.FilePath))
                {
                    result.IsValid = false;
                    _verificationErrors.Add(new VerificationError
                    {
                        AttachmentName = attachment.OriginalFilename ?? attachment.Name,
                        Issue = "Missing file path for external storage"
                    });
                }

                _verificationResults.Add(result);
            }

            ShowAlert($"Verification completed. {_verificationErrors.Count} issues found.", 
                     _verificationErrors.Any() ? "alert-warning" : "alert-success");
        }
        catch (Exception ex)
        {
            ShowAlert($"Verification failed: {ex.Message}", "alert-danger");
        }
        finally
        {
            _isVerifying = false;
        }
    }

    private void RecordMigrationHistory(string status, int? successCount = null, int? failedCount = null)
    {
        var duration = DateTime.Now - _migrationStartTime;
        _migrationHistory.Add(new MigrationHistoryItem
        {
            StartTime = _migrationStartTime,
            Duration = duration.ToString(@"mm\:ss"),
            TotalProcessed = _processedCount,
            SuccessCount = successCount ?? _processedCount,
            FailedCount = failedCount ?? 0,
            Status = status
        });
    }

    private void ClearErrors()
    {
        _migrationErrors.Clear();
    }

    private async Task<bool> ConfirmAction(string message)
    {
        // In a real implementation, this would show a proper confirmation dialog
        // For now, we'll return true to proceed
        await Task.CompletedTask;
        return true;
    }

    private void ShowAlert(string message, string cssClass)
