    }

    // New methods for enhanced functionality
    private void LoadStorageConfiguration()
    {
        _currentStorageProvider = Configuration["Storage:Provider"] ?? "Database";
        _azureConnectionStatus = _currentStorageProvider == "AzureBlobStorage";
