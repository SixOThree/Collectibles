@page "/admin/update-file-sizes"
@rendermode InteractiveServerWithoutPrerender
@attribute [Authorize(Policy = "AdminOnly")]
@inherits LoggablePageBase
@using Microsoft.AspNetCore.Authorization
@using Collectibles.Application.Features.Attachments.Commands
@using MediatR
@inject IMediator Mediator

<PageTitle>Update Attachment File Sizes</PageTitle>

<h1>Update Attachment File Sizes</h1>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Update File Sizes</h5>
                <p class="card-text">
                    This utility will update the file size for all existing attachments that currently show 0 bytes.
                    It calculates the size from the stored content in the database.
                </p>
                
                @if (!string.IsNullOrEmpty(_message))
                {
                    <div class="alert @(_isError ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
                        @_message
                        <button type="button" class="btn-close" @onclick="() => _message = string.Empty"></button>
                    </div>
                }
                
                <button class="btn btn-primary" @onclick="UpdateFileSizesAsync" disabled="@_isUpdating">
                    @if (_isUpdating)
                    {
                        <Spinner Type="SpinnerType.Dots" Size="SpinnerSize.Small" Color="SpinnerColor.Light" Class="me-2" />
                        <span>Updating...</span>
                    }
                    else
                    {
                        <span>Update File Sizes</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private bool _isUpdating = false;
    private string _message = string.Empty;
    private bool _isError = false;

    private async Task UpdateFileSizesAsync()
    {
        _isUpdating = true;
        _message = string.Empty;
        
        try
        {
            var updatedCount = await Mediator.Send(new UpdateAttachmentFileSizesCommand());
            _message = $"Successfully updated {updatedCount} attachment(s).";
            _isError = false;
        }
        catch (Exception ex)
        {
            _message = $"Error updating file sizes: {ex.Message}";
            _isError = true;
        }
        finally
        {
            _isUpdating = false;
        }
    }
}
