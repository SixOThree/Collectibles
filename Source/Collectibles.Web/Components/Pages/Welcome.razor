@page "/welcome"
@page "/"
@rendermode InteractiveServerWithoutPrerender
@inherits LoggablePageBase
@using Collectibles.Domain.Configuration
@using Collectibles.Application.Features.Showcases
@using Collectibles.Application.Features.Showcases.Queries
@using Collectibles.Application.Services
@using MediatR
@using Microsoft.Extensions.Options
@inject IOptions<SiteSettings> SiteSettings
@inject IMediator Mediator
@inject IHashIdsService HashIds

<PageTitle>@SiteSettings.Value.SiteTitle</PageTitle>

<div class="welcome-container">
    @* Repository hero — the project comes first *@
    <div class="repo-hero text-center">
        <h1>An open-source showcase platform for collectors</h1>
        <p class="lead">@SiteSettings.Value.SiteTitle is a .NET&nbsp;/&nbsp;Blazor project for cataloging, sharing, and managing collections. Explore the source, run it yourself, or contribute.</p>
        <div class="repo-hero-actions">
            <a class="btn btn-primary btn-lg" href="https://github.com/SixOThree/Collectibles" target="_blank" rel="noopener noreferrer">
                <i class="bi bi-github"></i> View on GitHub
            </a>
            <a class="btn btn-secondary btn-lg" href="/showcases/public">Browse Public Showcases</a>
            @if (_isAuthenticated)
            {
                <a class="btn btn-outline-secondary btn-lg" href="/showcases">Your Showcases</a>
            }
        </div>
    </div>

    @* Implementation feature grid — concrete code/project features *@
    <div class="welcome-features">
        <div class="feature-card">
            <div class="feature-icon"><i class="bi bi-grid-3x3-gap"></i></div>
            <h2>Template-Driven Fields</h2>
            <p>Collection templates define custom fields so each kind of collectible captures exactly the data that matters — text and large text areas, numbers, dates and date-times, booleans, dropdowns, and even inflation-adjusted prices.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon"><i class="bi bi-layers"></i></div>
            <h2>Blazor &amp; .NET</h2>
            <p>A .NET&nbsp;10 Blazor Server front end built on Clean Architecture — Domain, Application, Infrastructure, and Web layers, with a MAUI Blazor Hybrid QR scanner companion.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon"><i class="bi bi-share"></i></div>
            <h2>Public Sharing Routes</h2>
            <p>Showcases can be published to hash-id routes, letting collections be shared publicly without exposing internal identifiers.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon"><i class="bi bi-paperclip"></i></div>
            <h2>Attachments &amp; Media</h2>
            <p>Items support image and file attachments, with previews for many media types. Attachments can be uploaded in bulk via ZIP files with a hierarchical folder structure.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon"><i class="bi bi-palette"></i></div>
            <h2>Theme &amp; Configuration</h2>
            <p>A CSS-variable theme system and site settings drive styling and behavior without recompiling the application.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon"><i class="bi bi-speedometer2"></i></div>
            <h2>Admin &amp; Diagnostics</h2>
            <p>Management and diagnostics surfaces give administrators insight into the running application and its data.</p>
        </div>
    </div>

    @* Authenticated user shortcut — secondary, below the project content *@
    @if (!_isLoading && _isAuthenticated && _myShowcases != null && _myShowcases.Any())
    {
        <div class="user-showcase-card">
            @if (_myShowcases.Count == 1)
            {
                var sc = _myShowcases[0];
                var hash = HashIds.Encode(sc.Id);
                <a class="single-showcase-link" href="/showcase/@hash">
                    @if (!string.IsNullOrEmpty(sc.ImageUrl))
                    {
                        <img class="single-showcase-image" src="@sc.ImageUrl" alt="@sc.Name" />
                    }
                    else
                    {
                        <div class="single-showcase-placeholder">
                            <i class="bi bi-collection"></i>
                        </div>
                    }
                    <div class="single-showcase-content">
                        <div class="single-showcase-label">Your Showcase</div>
                        <h3 class="single-showcase-title">@sc.Name</h3>
                        @if (!string.IsNullOrEmpty(sc.Description))
                        {
                            <p class="single-showcase-desc">@sc.Description</p>
                        }
                        <div class="single-showcase-meta">
                            <span><i class="bi bi-box-seam"></i> @sc.ItemCount items</span>
                        </div>
                    </div>
                </a>
            }
            else
            {
                <div class="multi-showcase">
                    <div class="multi-showcase-text">
                        <div class="single-showcase-label">Welcome back</div>
                        <h3 class="multi-showcase-title">You have @_myShowcases.Count showcases</h3>
                        <p class="multi-showcase-sub">Jump in to view and manage your showcases.</p>
                    </div>
                    <a class="btn btn-primary btn-lg" href="/showcases">View Your Showcases</a>
                </div>
            }
        </div>
    }
</div>

@code {
    private bool _isLoading = true;
    private bool _isAuthenticated;
    private string? _userId;
    private List<ShowcaseCardDto>? _myShowcases;

    protected override async Task OnInitializedAsync()
    {
        // Determine auth state
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        _isAuthenticated = user?.Identity?.IsAuthenticated == true;
        _userId = user?.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (_isAuthenticated && !string.IsNullOrEmpty(_userId))
        {
            try
            {
                var showcases = await Mediator.Send(new GetShowcasesListQuery { UserId = _userId });
                // Only keep showcases owned by the current user
                _myShowcases = showcases?.Where(s => string.Equals(s.UserId, _userId, StringComparison.Ordinal)).ToList();
            }
            catch
            {
                // Swallow errors to avoid breaking the welcome page
                _myShowcases = new List<ShowcaseCardDto>();
            }
        }

        _isLoading = false;
    }
}
