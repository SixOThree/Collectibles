    private async Task ToggleFeatured(long attachmentId)
    {
        if (_item == null) return;

        try
        {
            var command = new ToggleAttachmentFeaturedCommand
            {
                CollectibleItemId = HashIds.Decode(Hash),
                AttachmentId = attachmentId
            };

            var isFeatured = await Mediator.Send(command);
            
            // Update the local state
            var attachment = _item.Attachments.FirstOrDefault(a => a.Id == attachmentId);
            if (attachment != null)
            {
                attachment.IsFeatured = isFeatured;
            }
            
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LogErrorToSysLog(ex, "toggling attachment featured status");
        }
    }

    private async Task ShowQRScanner()
    {
        if (_qrScannerModal != null)
        {
            await _qrScannerModal.ShowModal();
        }
    }
    
    private async Task HandleQRCodeScanned(string qrCode)
    {
        if (_item == null) return;
        
        _isProcessingQR = true;
        StateHasChanged();
        
        try
        {
            var command = new AssignQRCodeCommand
            {
                CollectibleItemHashId = Hash,
                QRCode = qrCode
            };
            
            var result = await Mediator.Send(command);
            
            if (result.Success)
            {
                _currentQRCode = result.QRCode;
                _item.QRCodeId = result.QRCode?.Id;
                _qrMessage = "QR code successfully assigned to this item!";
                _qrMessageType = "success";
            }
            else
            {
                _qrMessage = result.ErrorMessage ?? "Failed to assign QR code";
                _qrMessageType = "error";
            }
        }
        catch (Exception ex)
        {
            await LogErrorToSysLog(ex, "assigning QR code to collectible item");
            _qrMessage = $"Error: {ex.Message}";
            _qrMessageType = "error";
        }
        finally
        {
            _isProcessingQR = false;
            StateHasChanged();
            
            // Auto-hide message after 5 seconds
            if (!string.IsNullOrEmpty(_qrMessage))
            {
                _ = Task.Run(async () =>
                {
                    await Task.Delay(5000);
                    await InvokeAsync(() =>
                    {
                        _qrMessage = string.Empty;
                        StateHasChanged();
                    });
                });
            }
        }
    }
    
    private void HandleScannerClose()
    {
        // Nothing specific needed when scanner closes
    }
    
    private void ClearQRMessage()
    {
        _qrMessage = string.Empty;
        StateHasChanged();
    }

    private async Task ToggleLinkCaches(long linkInfoId)
    {
        if (_linkCaches.ContainsKey(linkInfoId))
        {
            _linkCaches.Remove(linkInfoId);
        }
        else
        {
            var query = new GetLinkCachesQuery { LinkInfoId = linkInfoId };
            var caches = await Mediator.Send(query);
            _linkCaches[linkInfoId] = caches;
        }
    }

