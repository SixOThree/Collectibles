    private void HandleChildItemClick(CollectibleItemCardDto childItem)
    {
        var itemHash = HashIds.Encode(childItem.Id);
        var url = $"/item/{itemHash}";
        if (_contextShowcase != null)
        {
            url += $"?showcase={HashIds.Encode(_contextShowcase.Id)}";
        }
        Navigation.NavigateTo(url);
    }
    
