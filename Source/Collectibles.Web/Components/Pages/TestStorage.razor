@page "/test-storage"
@attribute [Authorize(Policy = "AdminOnly")]
@inherits LoggablePageBase
@using Collectibles.Domain.Configuration
@using Collectibles.Domain.Configuration.Storage
@using Collectibles.Domain.Interfaces
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Options
@inject IFileStorage FileStorage
@inject IOptions<StorageSettings> StorageOptions
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebEnvironment

<PageTitle>Test Storage</PageTitle>

@if (!WebEnvironment.IsDevelopment())
{
    <div class="alert alert-warning">
        This diagnostic page is only available in the Development environment.
    </div>
}
else
{
<div>

<h1>Storage Provider Test</h1>

<div class="card">
    <div class="card-body">
        <h5 class="card-title">Current Storage Configuration</h5>
        <p><strong>Provider:</strong> @StorageOptions.Value.Provider</p>
        
        @if (StorageOptions.Value.Provider == Collectibles.Domain.Enums.StorageProvider.AzureBlobStorage)
        {
            <p><strong>Container:</strong> @StorageOptions.Value.AzureBlobStorage?.ContainerName</p>
        }
        else if (StorageOptions.Value.Provider == Collectibles.Domain.Enums.StorageProvider.LocalFileSystem)
        {
            <p><strong>Base Path:</strong> @StorageOptions.Value.LocalFileSystem?.BasePath</p>
        }
    </div>
</div>

<div class="card mt-3">
    <div class="card-body">
        <h5 class="card-title">Test File Operations</h5>
        
        <button class="btn btn-primary me-2" @onclick="TestSaveFile" disabled="@_isProcessing">
            @if (_isProcessing)
            {
                <Spinner Type="SpinnerType.Dots" Size="SpinnerSize.Small" Color="SpinnerColor.Light" Class="me-2" />
            }
            Test Save
        </button>
        
        <button class="btn btn-info me-2" @onclick="TestRetrieveFile" disabled="@(_isProcessing || string.IsNullOrEmpty(_savedFilePath))">
            Test Retrieve
        </button>
        
        <button class="btn btn-danger" @onclick="TestDeleteFile" disabled="@(_isProcessing || string.IsNullOrEmpty(_savedFilePath))">
            Test Delete
        </button>
        
        @if (!string.IsNullOrEmpty(_savedFilePath))
        {
            <div class="mt-3">
                <strong>Saved File Path:</strong> <code>@_savedFilePath</code>
            </div>
        }
        
        @if (!string.IsNullOrEmpty(_testResult))
        {
            <div class="alert @(_isError ? "alert-danger" : "alert-success") mt-3" role="alert">
                @_testResult
            </div>
        }
    </div>
</div>
</div>
}

@code {
    private bool _isProcessing = false;
    private string? _savedFilePath;
    private string? _testResult;
    private bool _isError = false;

    private async Task TestSaveFile()
    {
        _isProcessing = true;
        _isError = false;
        
        try
        {
            // Create test content
            var testContent = System.Text.Encoding.UTF8.GetBytes($"Test file content created at {DateTime.UtcNow}");
            var fileName = $"test-{Guid.NewGuid()}.txt";
            
            // Save file
            _savedFilePath = await FileStorage.SaveFileAsync(testContent, fileName, "text/plain");
            
            _testResult = $"File saved successfully! Path: {_savedFilePath}";
        }
        catch (Exception ex)
        {
            _isError = true;
            _testResult = $"Error saving file: {ex.Message}";
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task TestRetrieveFile()
    {
        _isProcessing = true;
        _isError = false;
        
        try
        {
            if (string.IsNullOrEmpty(_savedFilePath))
            {
                throw new InvalidOperationException("No file path available");
            }
            
            // Retrieve file
            var content = await FileStorage.GetFileAsync(_savedFilePath);
            
            if (content != null)
            {
                var textContent = System.Text.Encoding.UTF8.GetString(content);
                _testResult = $"File retrieved successfully! Content: {textContent}";
            }
            else
            {
                _isError = true;
                _testResult = "File not found!";
            }
        }
        catch (Exception ex)
        {
            _isError = true;
            _testResult = $"Error retrieving file: {ex.Message}";
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task TestDeleteFile()
    {
        _isProcessing = true;
        _isError = false;
        
        try
        {
            if (string.IsNullOrEmpty(_savedFilePath))
            {
                throw new InvalidOperationException("No file path available");
            }
            
            // Delete file
            await FileStorage.DeleteFileAsync(_savedFilePath);
            
            // Verify deletion
            var content = await FileStorage.GetFileAsync(_savedFilePath);
            
            if (content == null)
            {
                _testResult = "File deleted successfully!";
                _savedFilePath = null;
            }
            else
            {
                _isError = true;
                _testResult = "File deletion failed - file still exists!";
            }
        }
        catch (Exception ex)
        {
            _isError = true;
            _testResult = $"Error deleting file: {ex.Message}";
        }
        finally
        {
            _isProcessing = false;
        }
    }
}