    private async Task HandleDeleteConfirmed(ChildItemAction childItemAction)
    {
        if (_item == null) return;

        try
        {
            var command = new DeleteCollectibleItemCommand
            {
                Id = _item.Id,
                ChildItemAction = childItemAction
            };

            var result = await Mediator.Send(command);

            if (result.Success)
            {
                // Navigate back to the showcases page after successful deletion
                Navigation.NavigateTo("/showcases");
            }
            else
            {
                // Handle error - the modal will display the error message
                Console.WriteLine($"Failed to delete item: {result.ErrorMessage}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting item: {ex.Message}");
            throw; // Let the modal handle the exception
        }
    }

    private Task HandleDeleteCancelled()
    {
        // Nothing special to do when delete is cancelled
        return Task.CompletedTask;
    }
    
    private async Task HandleLinkAdded()
    {
        // Only reload the external links to avoid losing unsaved changes
        if (_item != null)
        {
            try
            {
                var id = HashIds.Decode(Hash);
                var query = new GetCollectibleItemByIdQuery { Id = id };
                var updatedItem = await Mediator.Send(query);
                
                if (updatedItem != null)
                {
                    // Update only the external references
                    _item.ExternalReferences = updatedItem.ExternalReferences;
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error refreshing links: {ex.Message}");
            }
        }
    }

    private async Task SetUnsavedChangesAsync(bool hasChanges)
    {
        _hasUnsavedChanges = hasChanges;
        if (_jsInitialized)
        {
            await JSRuntime.InvokeVoidAsync("unsavedChangesHandler.setUnsavedChanges", hasChanges);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_jsInitialized)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("unsavedChangesHandler.disable");
            }
            catch (JSDisconnectedException)
            {
                // Circuit disconnected, ignore
            }
        }
    }
