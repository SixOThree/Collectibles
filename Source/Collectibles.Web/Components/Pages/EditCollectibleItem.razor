    private async Task RecomputeCollage()
    {
        if (_item == null) return;

        _recomputingCollage = true;
        StateHasChanged();

        try
        {
            var command = new RecomputeCollagePreviewCommand(_item.Id);
            var result = await Mediator.Send(command);

            if (result.Success)
            {
                // Reload the item to pick up the new preview attachment and ID
                var reloaded = await Mediator.Send(new GetCollectibleItemByIdQuery { Id = _item.Id });
                if (reloaded != null)
                {
                    _item.PreviewImage = reloaded.PreviewImage;
                    _item.PreviewImageId = reloaded.PreviewImageId;
                    _command.PreviewImageId = reloaded.PreviewImageId;

                    // Update base64 thumbnail if available from the result
                    if (!string.IsNullOrEmpty(result.Base64Thumbnail) && _item.PreviewImage != null)
                    {
                        _item.PreviewImage.Base64PreviewThumbnail = result.Base64Thumbnail;
                    }
                }

                StateHasChanged();
            }
            else
            {
                await LogErrorToSysLog(new Exception(result.ErrorMessage), "generating collage preview");
            }
        }
        catch (Exception ex)
        {
            await LogErrorToSysLog(ex, "generating collage preview");
        }
        finally
        {
            _recomputingCollage = false;
            StateHasChanged();
        }
    }

