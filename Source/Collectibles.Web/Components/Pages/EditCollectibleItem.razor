    private Task OnPreviewSelected(AttachmentBriefDto? selected)
    {
        if (selected == null)
        {
            _command.PreviewImageId = null;
            _selectedPreviewAttachment = null;
            _hasUnsavedChanges = true;
            return Task.CompletedTask;
        }

        _command.PreviewImageId = selected.Id;
        _selectedPreviewAttachment = selected;
        _hasUnsavedChanges = true;

        // Ensure the selected attachment is part of the item's attachments for backend validation
        if (!_selectedAttachmentIds.Contains(selected.Id))
        {
            _selectedAttachmentIds.Add(selected.Id);
        }
        if (_item != null && !_item.Attachments.Any(a => a.Id == selected.Id))
        {
            _item.Attachments.Add(selected);
        }

        StateHasChanged();
        return Task.CompletedTask;
    }

    private void OnPreviewSelectorClosed()
    {
        // no-op; reserved for future needs
    }

    private AttachmentBriefDto? GetCurrentPreviewBrief()
    {
        if (_item == null)
        {
            return null;
        }

        if (_command.PreviewImageId.HasValue)
        {
            var fromList = _item.Attachments.FirstOrDefault(a => a.Id == _command.PreviewImageId.Value);
            if (fromList != null)
            {
                return fromList;
            }
            if (_selectedPreviewAttachment != null && _selectedPreviewAttachment.Id == _command.PreviewImageId.Value)
            {
                return _selectedPreviewAttachment;
            }
        }

        // Fallback to original preview (preloaded)
        return _item.PreviewImage != null ? new AttachmentBriefDto
        {
            Id = _item.PreviewImage.Id,
            Name = _item.PreviewImage.Name,
            OriginalFilename = _item.PreviewImage.OriginalFilename,
            FileType = _item.PreviewImage.FileType,
            AttachmentType = _item.PreviewImage.AttachmentType,
            Base64PreviewThumbnail = _item.PreviewImage.Base64PreviewThumbnail,
            Created = _item.PreviewImage.Created,
            IsFeatured = _item.PreviewImage.IsFeatured,
        } : null;
    }

    private string GetCurrentPreviewSrc(AttachmentBriefDto brief)
    {
        if (!string.IsNullOrEmpty(brief.Base64PreviewThumbnail) && !string.IsNullOrEmpty(brief.FileType))
        {
            return $"data:{brief.FileType};base64,{brief.Base64PreviewThumbnail}";
        }
        // Use direct attachment preview URL
        var hash = HashIds.Encode(brief.Id);
        return $"/api/attachments/{hash}/preview";
    }

    private string GetAttachmentPreviewSrc(AttachmentBriefDto att)
    {
        if (!string.IsNullOrEmpty(att.Base64PreviewThumbnail) && !string.IsNullOrEmpty(att.FileType))
        {
            return $"data:{att.FileType};base64,{att.Base64PreviewThumbnail}";
        }
        var hash = HashIds.Encode(att.Id);
        return $"/api/attachments/{hash}/preview";
    }

