@page "/users/new"
@rendermode InteractiveServerWithoutPrerender
@attribute [Authorize(Policy = "AdminOnly")]
@inherits LoggablePageBase
@using Collectibles.Application.Features.Users.Commands
@using Collectibles.Application.Features.Users.Dtos
@using Collectibles.Application.Features.Users.Queries
@using Microsoft.AspNetCore.Authorization
@using MediatR
@attribute [Authorize(Policy = "AdminOnly")]
@inject IMediator Mediator
@inject NavigationManager Navigation

<PageTitle>Create New User</PageTitle>

<div class="page-header">
    <h1>Create New User</h1>
</div>

<div class="row">
    <div class="col-md-6">
        <EditForm Model="@_model" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" />

            <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <InputText id="email" type="email" class="form-control" @bind-Value="_model.Email" />
                <ValidationMessage For="@(() => _model.Email)" />
            </div>

            <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <InputText id="password" type="password" class="form-control" @bind-Value="_model.Password" />
                <ValidationMessage For="@(() => _model.Password)" />

            </div>

            <div class="mb-3">
                <label for="confirmPassword" class="form-label">Confirm Password</label>
                <InputText id="confirmPassword" type="password" class="form-control" @bind-Value="_confirmPassword" />
                @if (!string.IsNullOrEmpty(_confirmPassword) && _confirmPassword != _model.Password)
                {
                    <div class="text-danger">Passwords do not match</div>
                }
            </div>

            <hr />

            <div class="mb-3">
                <label for="displayName" class="form-label">Display Name</label>
                <InputText id="displayName" class="form-control" @bind-Value="_model.DisplayName" />
                <ValidationMessage For="@(() => _model.DisplayName)" />
            </div>

            <div class="mb-3">
                <div class="form-check">
                    <InputCheckbox id="isActive" class="form-check-input" @bind-Value="_model.IsActive" />
                    <label class="form-check-label" for="isActive">
                        Active
                    </label>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Roles</label>
                @if (_availableRoles != null)
                {
                    @foreach (var role in _availableRoles)
                    {
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="@($"role-{role.Id}")"
                                   checked="@(_model.Roles.Contains(role.Name))"
                                   @onchange="@((ChangeEventArgs e) => ToggleRole(role.Name, e.Value))" />
                            <label class="form-check-label" for="@($"role-{role.Id}")">
                                @role.Name
                                @if (role.UserCount > 0)
                                {
                                    <span class="text-muted">(@role.UserCount users)</span>
                                }
                            </label>
                        </div>
                    }
                }
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-primary" disabled="@(_isSubmitting || !IsValid())">
                    @if (_isSubmitting)
                    {
                        <Spinner Type="SpinnerType.Dots" Size="SpinnerSize.Small" Color="SpinnerColor.Light" Class="me-2" />
                    }
                    Create User
                </button>
                <button type="button" class="btn btn-secondary ms-2" @onclick="Cancel">Cancel</button>
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    @_errorMessage
                </div>
            }
        </EditForm>
    </div>
</div>

@code {
    private CreateUserCommand _model = new()
    {
        IsActive = true
    };
    private string _confirmPassword = "";
    private List<RoleDto>? _availableRoles;
    private bool _isSubmitting = false;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadRoles();
    }

    private async Task LoadRoles()
    {
        try
        {
            _availableRoles = await Mediator.Send(new GetRolesListQuery());
        }
        catch (Exception ex)
        {
            _errorMessage = "Failed to load roles: " + ex.Message;
        }
    }

    private void ToggleRole(string roleName, object? isChecked)
    {
        if (isChecked is bool checkedValue)
        {
            if (checkedValue && !_model.Roles.Contains(roleName))
            {
                _model.Roles.Add(roleName);
            }
            else if (!checkedValue)
            {
                _model.Roles.Remove(roleName);
            }
        }
    }

    private bool IsValid()
    {
        return !string.IsNullOrWhiteSpace(_model.Email) &&
               !string.IsNullOrWhiteSpace(_model.Password) &&
               _model.Password == _confirmPassword &&
               _model.Password.Length >= 12;
    }

    private async Task HandleSubmit()
    {
        if (!IsValid())
        {
            return;
        }


        _isSubmitting = true;
        _errorMessage = null;

        try
        {
            var userId = await Mediator.Send(_model);
            Navigation.NavigateTo($"/users/{userId}");
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/users");
    }
}