@using Collectibles.Application.Showcases.Commands.GenerateShareLink
@using Collectibles.Application.Showcases.Commands.RevokeShareToken
@using Collectibles.Application.Showcases.Queries.GetShareTokens
@using MediatR
@inject IMediator Mediator
@inject IJSRuntime JS
@inject NavigationManager Navigation

@if (IsVisible)
{
    <div class="modal fade show" style="display: block;" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Share "@ShowcaseName"</h5>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>
                <div class="modal-body">
                    @if (_loading)
                    {
                        <div class="text-center py-4">
                            <Spinner Type="SpinnerType.Dots" Color="SpinnerColor.Primary" />
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    }
                    else
                    {
                        <!-- Generate New Link Section -->
                        <div class="card mb-4">
                            <div class="card-header bg-light">
                                <h6 class="mb-0">Generate New Share Link</h6>
                            </div>
                            <div class="card-body">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label">Expiration (Optional)</label>
                                        <input type="datetime-local" class="form-control" @bind="_expiresAt" />
                                        <div class="form-text">Leave blank for no expiration</div>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Note (Optional)</label>
                                        <input type="text" class="form-control" @bind="_note" placeholder="e.g., Shared with John" />
                                        <div class="form-text">For your reference only</div>
                                    </div>
                                    <div class="col-12">
                                        <button class="btn btn-primary" @onclick="GenerateShareLink" disabled="@_generating">
                                            @if (_generating)
                                            {
                                                <Spinner Type="SpinnerType.Dots" Size="SpinnerSize.Small" Color="SpinnerColor.Light" Class="me-2" />
                                            }
                                            <i class="bi bi-link-45deg"></i> Generate Share Link
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Active Share Links Section -->
                        <div class="card">
                            <div class="card-header bg-light">
                                <h6 class="mb-0">Active Share Links</h6>
                            </div>
                            <div class="card-body">
                                @if (_shareTokens.Any())
                                {
                                    <div class="table-responsive">
                                        <table class="table table-sm">
                                            <thead>
                                                <tr>
                                                    <th>Link</th>
                                                    <th>Created</th>
                                                    <th>Expires</th>
                                                    <th>Views</th>
                                                    <th>Note</th>
                                                    <th>Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var token in _shareTokens.Where(t => t.IsActive && !t.IsExpired))
                                                {
                                                    <tr>
                                                        <td>
                                                            <div class="input-group input-group-sm">
                                                                <input type="text" class="form-control" value="@GetFullUrl(token.ShareUrl)" readonly />
                                                                <button class="btn btn-outline-secondary" @onclick="() => CopyToClipboard(GetFullUrl(token.ShareUrl))" title="Copy link">
                                                                    <i class="bi bi-clipboard"></i>
                                                                </button>
                                                            </div>
                                                        </td>
                                                        <td class="small">@token.Created.ToString("MMM d, yyyy")</td>
                                                        <td class="small">
                                                            @if (token.ExpiresAt.HasValue)
                                                            {
                                                                @token.ExpiresAt.Value.ToString("MMM d, yyyy")
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted">Never</span>
                                                            }
                                                        </td>
                                                        <td class="small">@token.ViewCount</td>
                                                        <td class="small">
                                                            @if (!string.IsNullOrWhiteSpace(token.Note))
                                                            {
                                                                @token.Note
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted">-</span>
                                                            }
                                                        </td>
                                                        <td>
                                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => RevokeToken(token.Id)" title="Revoke link">
                                                                <i class="bi bi-x-circle"></i>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>

                                    <!-- Expired/Revoked Links -->
                                    @if (_shareTokens.Any(t => !t.IsActive || t.IsExpired))
                                    {
                                        <details class="mt-3">
                                            <summary class="text-muted small">Show expired/revoked links (@_shareTokens.Count(t => !t.IsActive || t.IsExpired))</summary>
                                            <div class="table-responsive mt-2">
                                                <table class="table table-sm table-striped">
                                                    <thead>
                                                        <tr>
                                                            <th>Created</th>
                                                            <th>Status</th>
                                                            <th>Views</th>
                                                            <th>Note</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var token in _shareTokens.Where(t => !t.IsActive || t.IsExpired))
                                                        {
                                                            <tr class="text-muted">
                                                                <td class="small">@token.Created.ToString("MMM d, yyyy")</td>
                                                                <td class="small">
                                                                    @if (!token.IsActive)
                                                                    {
                                                                        <span class="badge bg-secondary">Revoked</span>
                                                                    }
                                                                    else if (token.IsExpired)
                                                                    {
                                                                        <span class="badge bg-warning text-dark">Expired</span>
                                                                    }
                                                                </td>
                                                                <td class="small">@token.ViewCount</td>
                                                                <td class="small">@(token.Note ?? "-")</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </details>
                                    }
                                }
                                else
                                {
                                    <p class="text-muted mb-0">No share links have been generated yet.</p>
                                }
                            </div>
                        </div>

                        @if (_successMessage != null)
                        {
                            <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
                                @_successMessage
                                <button type="button" class="btn-close" @onclick="() => _successMessage = null"></button>
                            </div>
                        }

                        @if (_errorMessage != null)
                        {
                            <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
                                @_errorMessage
                                <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button>
                            </div>
                        }
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="Close">Close</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    [Parameter] public long ShowcaseId { get; set; }
    [Parameter] public string ShowcaseName { get; set; } = string.Empty;
    [Parameter] public EventCallback OnClose { get; set; }

    private bool IsVisible => ShowcaseId > 0;
    private bool _loading = true;
    private bool _generating = false;
    private List<ShareTokenDto> _shareTokens = new();
    private DateTime? _expiresAt;
    private string? _note;
    private string? _successMessage;
    private string? _errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        if (IsVisible)
        {
            await LoadShareTokens();
        }
    }

    private async Task LoadShareTokens()
    {
        try
        {
            _loading = true;
            _shareTokens = await Mediator.Send(new GetShareTokensQuery { ShowcaseId = ShowcaseId });
        }
        catch (Exception ex)
        {
            _errorMessage = "Failed to load share links.";
            Console.Error.WriteLine($"Error loading share tokens: {ex}");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task GenerateShareLink()
    {
        try
        {
            _generating = true;
            _errorMessage = null;
            _successMessage = null;

            var command = new GenerateShareLinkCommand
            {
                ShowcaseId = ShowcaseId,
                ExpiresAt = _expiresAt,
                Note = _note
            };

            var result = await Mediator.Send(command);
            
            var fullUrl = GetFullUrl(result.ShareUrl);
            _successMessage = "Share link generated successfully! The link has been copied to your clipboard.";
            await CopyToClipboard(fullUrl);
            
            // Clear form
            _expiresAt = null;
            _note = null;
            
            // Reload tokens
            await LoadShareTokens();
        }
        catch (Exception ex)
        {
            _errorMessage = "Failed to generate share link.";
            Console.Error.WriteLine($"Error generating share link: {ex}");
        }
        finally
        {
            _generating = false;
        }
    }

    private async Task RevokeToken(long tokenId)
    {
        try
        {
            var result = await Mediator.Send(new RevokeShareTokenCommand { TokenId = tokenId });
            
            if (result)
            {
                _successMessage = "Share link revoked successfully.";
                await LoadShareTokens();
            }
            else
            {
                _errorMessage = "Failed to revoke share link.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "Failed to revoke share link.";
            Console.Error.WriteLine($"Error revoking token: {ex}");
        }
    }

    private async Task CopyToClipboard(string text)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
        }
        catch
        {
            // Clipboard API might not be available
        }
    }

    private string GetFullUrl(string relativeUrl)
    {
        var uri = new Uri(Navigation.Uri);
        var baseUrl = $"{uri.Scheme}://{uri.Authority}";
        return $"{baseUrl}{relativeUrl}";
    }

    private void Close()
    {
        OnClose.InvokeAsync();
    }
}