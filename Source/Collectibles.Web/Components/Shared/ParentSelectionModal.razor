@using Collectibles.Application.Features.CollectibleItems
@using Collectibles.Application.Features.CollectibleItems.Queries
@using MediatR
@inject IMediator Mediator
@inject Collectibles.Application.Services.IHashIdsService HashIds

@if (_isVisible)
{
    <div class="modal-backdrop" @onclick="CloseModal">
        <div class="modal-dialog modal-lg" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Select Parent Item</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <div class="input-group">
                            <input type="text" class="form-control" placeholder="Search items..." 
                                   @bind="_searchTerm" @bind:event="oninput" @onkeyup="@(async (e) => { if (e.Key == "Enter") await SearchItems(); })" />
                            <button class="btn btn-outline-secondary" type="button" @onclick="SearchItems">
                                <i class="bi bi-search"></i> Search
                            </button>
                        </div>
                    </div>

                    @if (_loading)
                    {
                        <div class="text-center my-4">
                            <Spinner Type="SpinnerType.Dots" Color="SpinnerColor.Primary" />
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    }
                    else if (_items != null && _items.Any())
                    {
                        <div class="list-group">
                            @foreach (var item in _items)
                            {
                                <button type="button" class="list-group-item list-group-item-action d-flex align-items-center @(item.Id == SelectedItemId ? "active" : "")" 
                                        @onclick="() => SelectItem(item)">
                                    <div class="flex-grow-1">
                                        <h6 class="mb-1">@item.Name</h6>
                                        @if (!string.IsNullOrEmpty(item.DetailedDescription))
                                        {
                                            <p class="mb-1 small @(item.Id == SelectedItemId ? "text-white-50" : "text-muted")">
                                                @(item.DetailedDescription.Length > 100 ? item.DetailedDescription.Substring(0, 100) + "..." : item.DetailedDescription)
                                            </p>
                                        }
                                        @if (!string.IsNullOrEmpty(item.ParentName))
                                        {
                                            <small class="@(item.Id == SelectedItemId ? "text-white-50" : "text-muted")">
                                                <i class="bi bi-diagram-2"></i> Parent: @item.ParentName
                                            </small>
                                        }
                                    </div>
                                    @if (!string.IsNullOrEmpty(item.PreviewImageUrl))
                                    {
                                        <LazyImage Src="@item.PreviewImageUrl" 
                                                   Alt="@item.Name"
                                                   Class="ms-3"
                                                   Style="width: 60px; height: 60px; object-fit: cover; border-radius: 4px;"
                                                   ShowPlaceholder="false" />
                                    }
                                </button>
                            }
                        </div>

                        @if (_totalPages > 1)
                        {
                            <nav aria-label="Search results pagination" class="mt-3">
                                <ul class="pagination justify-content-center flex-wrap">
                                    <li class="page-item @(_currentPage == 1 ? "disabled" : "")">
                                        <button class="page-link" @onclick="() => LoadPage(_currentPage - 1)" disabled="@(_currentPage == 1)">
                                            Previous
                                        </button>
                                    </li>
                                    @foreach (var pageNumber in GetVisiblePageNumbers())
                                    {
                                        if (pageNumber == -1)
                                        {
                                            <li class="page-item disabled">
                                                <span class="page-link">&hellip;</span>
                                            </li>
                                        }
                                        else
                                        {
                                            var pn = pageNumber;
                                            <li class="page-item @(_currentPage == pn ? "active" : "")">
                                                <button class="page-link" @onclick="() => LoadPage(pn)">
                                                    @pn
                                                </button>
                                            </li>
                                        }
                                    }
                                    <li class="page-item @(_currentPage == _totalPages ? "disabled" : "")">
                                        <button class="page-link" @onclick="() => LoadPage(_currentPage + 1)" disabled="@(_currentPage == _totalPages)">
                                            Next
                                        </button>
                                    </li>
                                </ul>
                            </nav>
                        }
                    }
                    else if (!_loading && _hasSearched)
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i> No items found matching your search.
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    @if (SelectedItemId.HasValue)
                    {
                        <button type="button" class="btn btn-danger" @onclick="ClearSelection">
                            <i class="bi bi-x-circle"></i> Clear Parent
                        </button>
                    }
                    <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="ConfirmSelection" disabled="@(!SelectedItemId.HasValue)">
                        Select
                    </button>
                </div>
            </div>
        </div>
    </div>
}


@code {
    [Parameter] public long? SelectedItemId { get; set; }
    [Parameter] public EventCallback<long?> SelectedItemIdChanged { get; set; }
    [Parameter] public long? ExcludeItemId { get; set; }
    [Parameter] public List<long>? ShowcaseIds { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private bool _isVisible = false;
    private bool _loading = false;
    private bool _hasSearched = false;
    private string _searchTerm = "";
    private List<CollectibleItemDto>? _items;
    private int _currentPage = 1;
    private int _totalPages = 1;
    private const int PageSize = 25;

    public async Task ShowModal()
    {
        _isVisible = true;
        _hasSearched = false;
        _items = null;
        await SearchItems();
    }

    private async Task SearchItems()
    {
        _loading = true;
        _hasSearched = true;
        StateHasChanged();

        try
        {
            var query = new SearchCollectibleItemsQuery
            {
                SearchTerm = _searchTerm,
                ExcludeId = ExcludeItemId,
                ShowcaseIds = ShowcaseIds,
                PageNumber = _currentPage,
                PageSize = PageSize
            };

            var result = await Mediator.Send(query);
            _items = result.Items;
            _totalPages = result.TotalPages;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error searching items: {ex.Message}");
            _items = new List<CollectibleItemDto>();
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task LoadPage(int pageNumber)
    {
        if (pageNumber < 1 || pageNumber > _totalPages) return;
        _currentPage = pageNumber;
        await SearchItems();
    }

    private void SelectItem(CollectibleItemDto item)
    {
        SelectedItemId = item.Id;
    }

    private void ClearSelection()
    {
        SelectedItemId = null;
    }

    private async Task ConfirmSelection()
    {
        await SelectedItemIdChanged.InvokeAsync(SelectedItemId);
        await CloseModal();
    }

    private List<int> GetVisiblePageNumbers()
    {
        var pages = new List<int>();
        const int maxVisible = 7;

        if (_totalPages <= maxVisible)
        {
            for (int i = 1; i <= _totalPages; i++)
            {
                pages.Add(i);
            }
        }
        else
        {
            // Always show first page
            pages.Add(1);

            int start = Math.Max(2, _currentPage - 1);
            int end = Math.Min(_totalPages - 1, _currentPage + 1);

            // Adjust range to show at least 3 middle pages
            if (start <= 3)
            {
                end = Math.Max(end, 4);
            }
            if (end >= _totalPages - 2)
            {
                start = Math.Min(start, _totalPages - 3);
            }

            start = Math.Max(2, start);
            end = Math.Min(_totalPages - 1, end);

            if (start > 2)
            {
                pages.Add(-1); // ellipsis
            }

            for (int i = start; i <= end; i++)
            {
                pages.Add(i);
            }

            if (end < _totalPages - 1)
            {
                pages.Add(-1); // ellipsis
            }

            // Always show last page
            pages.Add(_totalPages);
        }

        return pages;
    }

    private async Task CloseModal()
    {
        _isVisible = false;
        _searchTerm = "";
        _items = null;
        _currentPage = 1;
        _hasSearched = false;
        await OnClose.InvokeAsync();
    }
}