@using Collectibles.Application.Features.ContentDefinitions
@using Collectibles.Application.Features.ContentDefinitions.Commands
@using Collectibles.Application.Features.ContentDefinitions.Queries
@using Collectibles.Domain.ValueObjects.Templates
@using System.Text.Json
@using MediatR
@inject IMediator Mediator

@if (_template != null && _fields.Any() && Entries?.Count > 0)
{
    <div class="multi-entry-display">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">@_template.Name Entries</h5>
            <span class="badge bg-secondary">@Entries.Count @(Entries.Count == 1 ? "entry" : "entries")</span>
        </div>

        <div class="table-responsive">
            <table class="table table-sm table-striped table-bordered mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 40px">#</th>
                        @foreach (var field in _fields)
                        {
                            <th>@field.Label</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < _displayEntries.Count; i++)
                    {
                        var entry = _displayEntries[i];
                        <tr>
                            <td class="text-muted text-center">@(i + 1)</td>
                            @foreach (var field in _fields)
                            {
                                <td>@FormatFieldValue(field, entry.GetValueOrDefault(field.Name))</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Entries.Count > _pageSize)
        {
            <div class="d-flex justify-content-between align-items-center mt-2">
                <small class="text-muted">
                    Showing @((_currentPage - 1) * _pageSize + 1)-@Math.Min(_currentPage * _pageSize, Entries.Count) of @Entries.Count
                </small>
                <div class="btn-group btn-group-sm">
                    <button type="button" class="btn btn-outline-secondary" disabled="@(_currentPage <= 1)" @onclick="PreviousPage">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    <button type="button" class="btn btn-outline-secondary" disabled="@(_currentPage >= _totalPages)" @onclick="NextPage">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public long? TemplateId { get; set; }
    [Parameter, EditorRequired] public List<Dictionary<string, object?>>? Entries { get; set; }

    private ContentDefinitionDto? _template;
    private List<FieldDefinitionDto> _fields = new();
    private List<Dictionary<string, object?>> _displayEntries = new();
    private int _currentPage = 1;
    private int _pageSize = 25;
    private int _totalPages = 1;

    protected override async Task OnParametersSetAsync()
    {
        await LoadTemplate();
        UpdateDisplayEntries();
    }

    private async Task LoadTemplate()
    {
        if (TemplateId == null)
        {
            _template = null;
            _fields = new();
            return;
        }

        if (_template?.Id == TemplateId)
        {
            return;
        }

        try
        {
            _template = await Mediator.Send(new GetContentDefinitionByIdQuery(TemplateId.Value));
            if (_template != null)
            {
                _fields = _template.Fields.OrderBy(f => f.DisplayOrder).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading template: {ex.Message}");
            _template = null;
        }
    }

    private void UpdateDisplayEntries()
    {
        if (Entries == null || Entries.Count == 0)
        {
            _displayEntries = new();
            _totalPages = 1;
            return;
        }

        _totalPages = (int)Math.Ceiling((double)Entries.Count / _pageSize);
        _currentPage = Math.Clamp(_currentPage, 1, _totalPages);
        _displayEntries = Entries
            .Skip((_currentPage - 1) * _pageSize)
            .Take(_pageSize)
            .ToList();
    }

    private void NextPage()
    {
        if (_currentPage < _totalPages)
        {
            _currentPage++;
            UpdateDisplayEntries();
        }
    }

    private void PreviousPage()
    {
        if (_currentPage > 1)
        {
            _currentPage--;
            UpdateDisplayEntries();
        }
    }

    private string FormatFieldValue(FieldDefinitionDto field, object? value)
    {
        if (value == null)
        {
            return "\u2014";
        }

        var stringValue = value.ToString() ?? string.Empty;

        return field.FieldType switch
        {
            FieldType.Boolean => stringValue is "True" or "true" ? "Yes" : "No",
            FieldType.Date when DateTime.TryParse(stringValue, out var date) => date.ToString("MMM d, yyyy"),
            FieldType.DateTime when DateTime.TryParse(stringValue, out var dt) => dt.ToString("MMM d, yyyy h:mm tt"),
            FieldType.Number when decimal.TryParse(stringValue, out var num) => num.ToString("N2"),
            FieldType.InflationAdjustedPrice => FormatInflationPrice(stringValue),
            _ => stringValue,
        };
    }

    private string FormatInflationPrice(string value)
    {
        try
        {
            if (value.StartsWith('{'))
            {
                var json = JsonSerializer.Deserialize<JsonElement>(value);
                var price = json.GetProperty("Price").GetDecimal();
                var year = json.GetProperty("Year").GetInt32();
                return $"${price:N2} ({year})";
            }
        }
        catch
        {
            // Fall through to return raw value
        }

        return value;
    }
}

<style>
    .multi-entry-display {
        margin-bottom: 1rem;
    }

    .multi-entry-display .table td {
        vertical-align: middle;
    }
</style>
