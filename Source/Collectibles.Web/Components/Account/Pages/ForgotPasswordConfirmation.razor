@page "/Account/ForgotPasswordConfirmation"

@using Collectibles.Application.Interfaces
@using Collectibles.Domain.Entities

@inject IEmailConfigurationService EmailConfigurationService
@inject IEventLogService EventLogService

<PageTitle>Forgot password confirmation</PageTitle>

<h1>Forgot password confirmation</h1>

@if (!EmailConfigurationService.IsEmailConfigured())
{
    <div class="alert alert-warning" role="alert">
        <h4 class="alert-heading">@EmailConfigurationService.GetEmailNotConfiguredMessage()</h4>
        <p>@EmailConfigurationService.GetEmailNotConfiguredDetailMessage()</p>
        <p class="mb-0">Since email services are not configured, password reset via email is not available. Please contact your system administrator for assistance with resetting your password.</p>
    </div>
}
else
{
    <p>
        Please check your email to reset your password.
    </p>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        try
        {
            await EventLogService.LogEventAsync(
                EventAction.View,
                additionalData: System.Text.Json.JsonSerializer.Serialize(new { Page = "ForgotPasswordConfirmation" }));
        }
        catch { }
    }
}
