@page "/Account/ResetPasswordConfirmation"

@using Collectibles.Application.Interfaces
@using Collectibles.Domain.Entities

@inject IEventLogService EventLogService

<PageTitle>Reset password confirmation</PageTitle>

<h1>Reset password confirmation</h1>
<p>
    Your password has been reset. Please <a href="Account/Login">click here to log in</a>.
</p>

@code {
    protected override async Task OnInitializedAsync()
    {
        try
        {
            await EventLogService.LogEventAsync(
                EventAction.View,
                additionalData: System.Text.Json.JsonSerializer.Serialize(new { Page = "ResetPasswordConfirmation" }));
        }
        catch { }
    }
}
