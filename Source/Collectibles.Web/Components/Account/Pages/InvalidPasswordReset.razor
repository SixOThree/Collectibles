@page "/Account/InvalidPasswordReset"

@using Collectibles.Application.Interfaces
@using Collectibles.Domain.Entities

@inject IEventLogService EventLogService

<PageTitle>Invalid password reset</PageTitle>

<h1>Invalid password reset</h1>
<p>
    The password reset link is invalid.
</p>

@code {
    protected override async Task OnInitializedAsync()
    {
        try
        {
            await EventLogService.LogEventAsync(
                EventAction.View,
                additionalData: System.Text.Json.JsonSerializer.Serialize(new { Page = "InvalidPasswordReset" }));
        }
        catch { }
    }
}
