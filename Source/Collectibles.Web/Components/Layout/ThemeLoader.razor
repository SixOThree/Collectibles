@using Collectibles.Application.Interfaces
@using Collectibles.Domain.Constants
@inject IThemeService ThemeService
@inject IJSRuntime JSRuntime
@inject ILogger<ThemeLoader> Logger
@implements IDisposable
@rendermode InteractiveServer

<!-- Hidden div to ensure component renders -->
<div style="display: none;" data-theme-loader="active"></div>

@code {
    private bool _isInitialized = false;

    protected override void OnInitialized()
    {
        Logger.LogInformation("ThemeLoader OnInitialized called");
        base.OnInitialized();
    }

    protected override async Task OnInitializedAsync()
    {
        Logger.LogInformation("ThemeLoader OnInitializedAsync called");
        // Try loading theme here as well
        if (!_isInitialized)
        {
            _isInitialized = true;
            await LoadThemeAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        Logger.LogInformation($"ThemeLoader OnAfterRenderAsync called - firstRender: {firstRender}, isInitialized: {_isInitialized}");
        
        if (firstRender && !_isInitialized)
        {
            _isInitialized = true;
            await LoadThemeAsync();
        }
    }

    private async Task LoadThemeAsync()
    {
        Logger.LogInformation("ThemeLoader LoadThemeAsync started");
        try
        {
            var currentTheme = await ThemeService.GetCurrentThemeAsync();
            Logger.LogInformation($"ThemeLoader retrieved theme: {currentTheme}");
            
            if (!string.IsNullOrEmpty(currentTheme))
            {
                Logger.LogInformation($"ThemeLoader updating theme to: {currentTheme}");
                await JSRuntime.InvokeVoidAsync("console.log", $"About to update theme to: {currentTheme}");
                await JSRuntime.InvokeVoidAsync("updateTheme", currentTheme);
                Logger.LogInformation($"ThemeLoader theme update complete");
            }
            else
            {
                Logger.LogInformation($"ThemeLoader using default theme");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading theme");
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading theme: {ex.Message}");
        }
    }

    public void Dispose()
    {
        Logger.LogInformation("ThemeLoader disposed");
    }
}
