<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <system.webServer>
    <!-- Keep large upload and compression settings aligned with base config -->
    <security>
      <requestFiltering>
        <!-- Allow 20GB uploads -->
        <requestLimits maxAllowedContentLength="4294967295" xdt:Transform="Replace" />
      </requestFiltering>
    </security>

    <!-- Ensure compression stays enabled in Production -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" xdt:Transform="Replace" />
    <httpCompression>
      <dynamicTypes xdt:Transform="Replace">
        <add mimeType="application/octet-stream" enabled="true" />
        <add mimeType="application/zip" enabled="false" />
        <add mimeType="application/x-zip-compressed" enabled="false" />
      </dynamicTypes>
    </httpCompression>

    <!-- Production-specific tweaks: disable stdout logs; set environment to Production -->
    <aspNetCore xdt:Transform="SetAttributes"
                processPath="dotnet"
                arguments=".\Collectibles.Web.dll"
                stdoutLogEnabled="false"
                stdoutLogFile=".\logs\stdout"
                requestTimeout="00:20:00"
                hostingModel="InProcess">
      <environmentVariables>
        <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />
      </environmentVariables>
    </aspNetCore>

    <!-- Preload and warm-up for faster startups -->
    <applicationInitialization doAppInitAfterRestart="true" skipManagedModules="false" xdt:Transform="Insert">
      <add initializationPage="/health" />
    </applicationInitialization>
  </system.webServer>

  <system.web>
    <!-- Keep request length/timeouts consistent -->
    <httpRuntime maxRequestLength="20971520" executionTimeout="1200" xdt:Transform="Replace" />
  </system.web>
</configuration>

